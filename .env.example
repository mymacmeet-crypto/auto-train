# Copy to .env and fill in whichever backend you intend to use.
# Phase 5 only needs ONE of these — and needs none at all if you run Ollama
# locally or fall back to the structural generator.

# Anthropic — highest-quality instruction pairs, billed per page.
ANTHROPIC_API_KEY=

# OpenAI or any OpenAI-compatible endpoint (vLLM, LM Studio, together.ai).
# For a local server, point openai_base_url at it in your config; a key is
# then usually unnecessary.
OPENAI_API_KEY=

# Override any config value without editing a file. Semicolon-separated.
#   AUTOTRAIN_SET=crawler.max_pages=500;dataset.provider.backend=anthropic
AUTOTRAIN_SET=

# Hugging Face token, only needed for gated base models.
HF_TOKEN=
